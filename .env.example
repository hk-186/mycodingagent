# mycodingagent 环境变量模板：复制为 .env（或直接设置系统环境变量）后填入真实值
# .env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库

# ---- 模型接入（必填）----
AGICTO_API_KEY=sk-xxxx

# ---- 可选：覆盖默认模型端点 / 模型名 ----
# LLM_BASE_URL=https://api.agicto.cn/v1
# LLM_MODEL_NAME=deepseek-v4-flash
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# ---- 可选：联网搜索 ----
TAVILY_API_KEY=

# ---- 可选：LangSmith 追踪（显式设为 true 才开启）----
# LANGSMITH_TRACING=true

# ---- 可选：日志级别（默认 WARNING，调试时改 INFO/DEBUG）----
# LOG_LEVEL=INFO

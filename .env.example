# mycodingagent 环境变量模板：复制为 .env 并填入真实值，程序启动时自动加载
# （系统环境变量优先于 .env；.env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库）

# ---- 模型接入（必填）----
AGICTO_API_KEY=sk-xxxx

# ---- 可选：覆盖默认模型端点 / 模型名 ----
# LLM_BASE_URL=https://api.agicto.cn/v1
# LLM_MODEL_NAME=deepseek-v4-flash
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# ---- 可选：联网搜索 ----
TAVILY_API_KEY=

# ---- 可选：LangSmith 追踪（显式设为 true 才开启）----
# LANGSMITH_TRACING=true

# ---- 可选：默认工作目标项目目录（也可用启动参数 --project 覆盖，优先级更高）----
# AGENT_PROJECT_DIR=D:\path\to\your\repo

# ---- 可选：三重预算（阶段 2，超限安全停下，可用 /resume 续跑）----
# AGENT_RECURSION_LIMIT=80        # LangGraph 图步数上限（模型/工具节点各算一步）
# AGENT_MAX_STEPS=40              # 每任务模型调用轮次上限
# AGENT_TOKEN_BUDGET=300000       # 每任务累计 token 上限

# ---- 可选：验证闭环最大修复轮数（注入 system prompt，阶段 2）----
# VERIFY_LOOP_MAX_ROUNDS=5

# ---- 可选：审批粒度（阶段 3）----
# minimal   默认；只对危险/灰区命令触发审批（黑名单也走 interrupt 链路）
# all       所有写命令（execute 任意写操作）都触发审批
# disabled  完全关闭审批（仅供受信任场景调试用）
# APPROVAL_MODE=minimal

# ---- 可选：日志级别（默认 WARNING，调试时改 INFO/DEBUG）----
# LOG_LEVEL=INFO
